# GHN Analytics Platform - Local Development Environment Variables
# Copy this to .env and fill in your values - .env is gitignored

# GHN API Token (required for local runs)
GHN_API_TOKEN=your_ghn_api_token_here

# S3 bucket names (must match what CDK creates or you create manually)
RAW_BUCKET_NAME=ghn-analytics-dev-raw
CURATED_BUCKET_NAME=ghn-analytics-dev-curated

# Optional: Kinesis stream name
KINESIS_STREAM_NAME=ghn-analytics-dev-orders

# Logging
LOG_LEVEL=INFO
