# GHN Analytics Platform - Local Development Environment Variables
# Copy this to .env and fill in your values - .env is gitignored

# GHN API Token (required for local runs)
GHN_API_TOKEN=your_ghn_api_token_here

# S3 bucket names (must match what CDK creates or you create manually)
RAW_BUCKET_NAME=ghn-analytics-dev-raw


# Logging
LOG_LEVEL=INFO
# GHN gateway base URL. KEEP THE ENVIRONMENT AND TOKEN PAIRED:
#   staging token   -> https://dev-online-gateway.ghn.vn
#   production token -> https://online-gateway.ghn.vn
# A mismatched pair answers 401 "Token is not valid!". Request URLs
# carry the /shiip/public-api mount in front of the route (confirmed
# against the dev gateway). No trailing slash.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn

# GHN ShopId - the second auth header the current gateway generation
# requires. Leave blank if you are on API generation v3 (token-only auth).
GHN_SHOP_ID=
# To discover your staging value, set GHN_API_TOKEN and run:
#   python scripts/test_api.py --endpoint shops
# Optional order codes for manual API probes and backfills.
GHN_ORDER_CODES=
# The ward endpoint only answers per district. Comma-separated district
# ids whose wards are fetched on each run (keep it small).
GHN_WARD_DISTRICTS=

# Local GHN staging callback -> LocalStack (scripts/serve_webhook_local.py).
# Set the same private value in Developer Portal custom header
# X-GHN-Webhook-Token. This is portal-configured shared-token auth, not GHN HMAC.
GHN_CALLBACK_SHARED_TOKEN=replace_with_long_random_shared_token
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCAL_RAW_BUCKET_NAME=ghn-analytics-local-raw
LOCAL_WATCHLIST_TABLE_NAME=ghn-analytics-local-watchlist
LOCAL_WEBHOOK_QUEUE_NAME=ghn-analytics-local-webhook.fifo
LOCAL_WEBHOOK_PORT=8000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BRONZE_BUCKET=ghn-analytics-bronze
TRINO_ENDPOINT=http://localhost:8080
BRONZE_ICEBERG_TABLE=ghn_events
