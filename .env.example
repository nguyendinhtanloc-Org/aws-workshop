# GHN Analytics Platform - Local Development Environment Variables
# Copy this to .env and fill in your values - .env is gitignored

# GHN API Token (required for local runs)
GHN_API_TOKEN=your_ghn_api_token_here

# S3 bucket names (must match what CDK creates or you create manually)
RAW_BUCKET_NAME=ghn-analytics-dev-raw
CURATED_BUCKET_NAME=ghn-analytics-dev-curated

# Optional: Kinesis stream name
KINESIS_STREAM_NAME=ghn-analytics-dev-orders

# Logging
LOG_LEVEL=INFO
# GHN gateway base URL (production, per GHN's "API Environments" table).
# The /shiip/public-api URL in GHN docs is the documentation portal, not
# the API base. Do not add a trailing slash.
GHN_BASE_URL=https://online-gateway.ghn.vn

# GHN ShopId - the second auth header the current gateway generation
# requires. Leave blank if you are on API generation v3 (token-only auth).
GHN_SHOP_ID=
# Comma-separated order codes the Ingestor polls for details. The GHN
# API has no list-orders endpoint, so the watchlist is the order source;
# status *changes* in production are pushed by GHN's order-status webhook.
GHN_ORDER_CODES=
# The ward endpoint only answers per district. Comma-separated district
# ids whose wards are fetched on each run (keep it small).
GHN_WARD_DISTRICTS=
